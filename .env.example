# Postgres (Neon). Injected automatically by the Vercel Marketplace integration.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Auth.js: generate with `npx auth secret`
AUTH_SECRET=

# OAuth providers (a provider is offered only when both its values are set)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Comma-separated emails allowed to manage coupons via /api/admin/coupons
ADMIN_EMAILS=

# Public origin of the site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
